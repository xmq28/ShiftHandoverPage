@model IReadOnlyList<ShiftHandover.Web.Models.Shift>
@{
    ViewData["Title"] = "Shifts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Shifts</h1>
        <p class="text-muted mb-0">All scheduled shifts.</p>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning" role="status">@error</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">There are no shifts to display.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Shift</th>
                    <th scope="col">Date (Bahrain)</th>
                    <th scope="col">Hours (Bahrain, UTC+03:00)</th>
                    <th scope="col">Status</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var shift in Model)
                {
                    <tr>
                        <th scope="row">@shift.Title</th>
                        <td>@shift.ShiftDate.ToString("ddd, dd MMM yyyy")</td>
                        <td>@shift.StartTime.ToString("HH:mm")-@shift.EndTime.ToString("HH:mm")</td>
                        <td>
                            @switch (shift.Status)
                            {
                                case ShiftHandover.Web.Models.ShiftStatus.Available:
                                    <span class="badge bg-success">Available</span>
                                    break;
                                case ShiftHandover.Web.Models.ShiftStatus.Claimed:
                                    <span class="badge bg-warning text-dark">Claimed</span>
                                    break;
                                case ShiftHandover.Web.Models.ShiftStatus.Closed:
                                    <span class="badge bg-secondary">Closed</span>
                                    break;
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@shift.Id" class="btn btn-outline-secondary btn-sm">Details</a>
                            @if (shift.Status == ShiftHandover.Web.Models.ShiftStatus.Available)
                            {
                                <form asp-action="Claim" asp-route-id="@shift.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-primary btn-sm">Claim</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}