@model ShiftHandover.Web.Models.Shift
@{
    ViewData["Title"] = "Shift details";
}

<p><a asp-action="Index">&larr; All shifts</a></p>
<h1 class="h2">@Model.Title</h1>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

<dl class="row mt-4">
    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.ShiftDate.ToString("dddd, dd MMMM yyyy")</dd>
    <dt class="col-sm-3">Hours</dt>
    <dd class="col-sm-9">@Model.StartTime.ToString("HH:mm")-@Model.EndTime.ToString("HH:mm")</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
    @if (Model.ClaimedBySupervisor is not null)
    {
        <dt class="col-sm-3">Assigned supervisor</dt>
        <dd class="col-sm-9">@Model.ClaimedBySupervisor.FullName</dd>
    }
</dl>

@if (Model.Status == ShiftHandover.Web.Models.ShiftStatus.Available)
{
    <form asp-action="Claim" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-primary">Claim shift</button>
    </form>
}
else if (Model.Status == ShiftHandover.Web.Models.ShiftStatus.Claimed)
{
    <section class="mt-4" aria-labelledby="shift-records-heading">
        <h2 id="shift-records-heading" class="h4">Shift records</h2>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="ShiftRecords" asp-action="Accidents" asp-route-id="@Model.Id" class="btn btn-outline-primary">Accidents</a>
            <a asp-controller="ShiftRecords" asp-action="Incidents" asp-route-id="@Model.Id" class="btn btn-outline-primary">Incidents</a>
            <a asp-controller="ShiftRecords" asp-action="Manpower" asp-route-id="@Model.Id" class="btn btn-outline-primary">Manpower</a>
        </div>
    </section>
}