<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shift Handover</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ShiftHandover.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var activeController = ViewContext.RouteData.Values["controller"]?.ToString();
        var activeAction = ViewContext.RouteData.Values["action"]?.ToString();
    }
    <header class="site-header">
        <nav class="navbar navbar-expand-sm app-navbar" aria-label="Main navigation">
            <div class="app-shell nav-shell">
                <a class="navbar-brand brand-link" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Shift Handover dashboard">
                    <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7.5h10M4 12h16M4 16.5h10M17 5l3 2.5-3 2.5" /></svg></span>
                    <span>Shift <strong>Handover</strong></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav primary-nav">
                        <li class="nav-item">
                            <a class="nav-link @(activeController == "Home" && activeAction == "Index" ? "active" : "")" aria-current="@(activeController == "Home" && activeAction == "Index" ? "page" : null)" asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>
                        @if (User.IsInRole("Supervisor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(activeController == "Shifts" ? "active" : "")" aria-current="@(activeController == "Shifts" ? "page" : null)" asp-area="" asp-controller="Shifts" asp-action="Index">Shifts</a>
                            </li>
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="account-menu">
                            <span class="account-name"><span class="account-presence" aria-hidden="true"></span>@User.Identity.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-secondary btn-sm logout-button">Log out</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="app-shell app-content">
        <main role="main" class="app-main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="app-shell footer-inner">
            <span>Shift Handover</span>
            <span>Supervisor operations <span class="footer-divider" aria-hidden="true">·</span> Bahrain</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
