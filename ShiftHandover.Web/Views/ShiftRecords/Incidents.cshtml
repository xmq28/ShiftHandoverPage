@model IncidentLogViewModel
@{
    ViewData["Title"] = "Incident log";
}

<p><a asp-controller="Shifts" asp-action="Details" asp-route-id="@Model.ShiftId">&larr; @Model.ShiftTitle</a></p>
<h1 class="h2">Incident log</h1>

<form asp-action="Incidents" asp-route-id="@Model.ShiftId" method="post" class="mt-4 mb-5">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Input.OccurredAt" class="form-label">Date and time</label>
            <input asp-for="Input.OccurredAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
            <span asp-validation-for="Input.OccurredAt" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Category" class="form-label"></label>
            <input asp-for="Input.Category" class="form-control" />
            <span asp-validation-for="Input.Category" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Input.Description" class="form-label"></label>
            <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Input.Description" class="text-danger"></span>
        </div>
        <div class="col-md-6 form-check ms-2">
            <input asp-for="Input.Resolved" class="form-check-input" />
            <label asp-for="Input.Resolved" class="form-check-label"></label>
        </div>
        <div class="col-md-6 form-check ms-2">
            <input asp-for="Input.FollowUpRequired" class="form-check-input" />
            <label asp-for="Input.FollowUpRequired" class="form-check-label"></label>
        </div>
    </div>
    <button type="submit" class="btn btn-primary mt-3">Save incident</button>
</form>

<h2 class="h4">Recorded incidents</h2>
@if (Model.Records.Count == 0)
{
    <p class="text-muted">No incidents have been recorded for this shift.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Date and time</th><th>Category</th><th>Description</th><th>Resolved</th><th>Follow-up required</th></tr></thead>
            <tbody>
                @foreach (var record in Model.Records)
                {
                    <tr>
                        <td>@record.OccurredAt.ToString("g")</td>
                        <td>@record.Category</td>
                        <td>@record.Description</td>
                        <td>@(record.Resolved ? "Yes" : "No")</td>
                        <td>@(record.FollowUpRequired ? "Yes" : "No")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}